PROJECT_NAME           = "cli-srv"
PROJECT_BRIEF          = "Interactive CLI client and multi-threaded Unix domain socket server"

OUTPUT_DIRECTORY       = doc
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

INPUT                  = README.md \
                         app1_cli \
                         app2_server
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.cpp *.h *.hpp *.md
RECURSIVE              = YES
EXCLUDE                =

INPUT_ENCODING         = UTF-8
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
SHOW_INCLUDE_FILES     = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

REFERENCES_LINK_SOURCE = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        =

PREDEFINED             = __cplusplus=201703L

ALIASES                =

EXTENSION_MAPPING      =

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

CLASS_DIAGRAMS         = NO
HAVE_DOT               = NO

USE_MATHJAX            = NO
GENERATE_LEGEND        = YES
HTML_COLORSTYLE        = LIGHT
